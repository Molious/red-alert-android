{
  "expo": {
    "name": "Mole Beyond Test",
    "slug": "mole-beyond-hybrid-test",
    "version": "1.0.8",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "backgroundColor": "#05070b",
    "android": {
      "package": "com.molious.molebeyondtest",
      "versionCode": 9,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070b"
      }
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Red Alert to hear your voice commands, like \"weapons\", \"lock on\" and \"fire\".",
          "speechRecognitionPermission": "Allow Red Alert to recognise your spoken commands."
        }
      ],
      "./plugins/withTrustedWebView.cjs"
    ],
    "owner": "molious",
    "extra": {
      "eas": {
        "projectId": "3b15ffd0-bc1e-4013-8f82-d20e8a361e90"
      }
    }
  }
}
