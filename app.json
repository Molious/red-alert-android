{
  "expo": {
    "name": "Red Alert",
    "slug": "red-alert-android",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "backgroundColor": "#05070b",
    "android": {
      "package": "com.molious.redalert",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070b"
      }
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Red Alert to hear your voice commands, like \"weapons\", \"lock on\" and \"fire\".",
          "speechRecognitionPermission": "Allow Red Alert to recognise your spoken commands."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Red Alert uses your location while the app is open to turn your drive into the battle map.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./plugins/withTrustedWebView.cjs"
    ],
    "owner": "molious"
  }
}
